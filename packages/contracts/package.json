{
  "name": "@opspulse/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "pnpm build && pnpm typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --workspace-root build && vitest run --root ../.. --config vitest.config.ts packages/contracts/src"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "zod": "4.4.3"
  }
}
