#!/usr/bin/env bash
set -euo pipefail
exec docker run --rm --init \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -e COREPACK_HOME=/tmp/corepack \
  -e PNPM_HOME=/tmp/pnpm \
  -e PNPM_STORE_DIR=/workspace/.pnpm-store \
  -v "$PWD:/workspace" \
  -w /workspace \
  node:24.18.0-bookworm \
  sh -lc 'if [ "$1" = pnpm ]; then shift; exec corepack pnpm "$@"; else exec "$@"; fi' sh "$@"
